{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react","react-perf","oxc","typescript"],
  "ignorePatterns": ["node_modules/**", "dist/**", ".turbo/**", "bun.lock"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    // falso positivo com o JSX transform moderno (jsx: react-jsx) — React não precisa estar em escopo
    "react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      // código gerado pelo shadcn — não mexemos no estilo dele
      "files": ["apps/web/src/components/ui/**"],
      "rules": {
        "no-shadow": "off"
      }
    }
  ]
}
